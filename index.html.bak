<style>
/* Spinner loading kecil untuk tombol */
.btn-spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    vertical-align: middle;
    border: 2px solid #ccc;
    border-top: 2px solid #6366f1;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-right: 6px;
}
</style>
<script>
// Loading handler untuk tombol Simpan/Edit di formUjianGuru dan semua tombol aksi .btn-edit
document.addEventListener('DOMContentLoaded', function() {
    // Form Simpan
    var formGuru = document.getElementById('formUjianGuru');
    if (formGuru) {
        formGuru.addEventListener('submit', function(e) {
            var btn = formGuru.querySelector('.btn-primary[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="btn-spinner"></span>Menyimpan...';
            }
            setTimeout(function() {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = 'Simpan';
                }
            }, 1800);
        });
    }
    // Semua tombol aksi edit
    function setupEditLoading() {
        var editBtns = document.querySelectorAll('.btn-edit');
        editBtns.forEach(function(editBtn) {
            if (!editBtn.dataset.loadingBound) {
                editBtn.addEventListener('click', function(e) {
                    editBtn.disabled = true;
                    var old = editBtn.innerHTML;
                    editBtn.innerHTML = '<span class="btn-spinner"></span>Loading...';
                    setTimeout(function() {
                        editBtn.disabled = false;
                        editBtn.innerHTML = old;
                    }, 1500);
                });
                editBtn.dataset.loadingBound = '1';
            }
        });
    }
    setupEditLoading();
    // Jika ada dynamic render, panggil setupEditLoading() lagi setelah render
    // Contoh: window.renderExamList = setupEditLoading;
    window.setupEditLoading = setupEditLoading;
});
</script>
<style>
/* Tombol Batal & Simpan horizontal di formUjianGuru */
#formUjianGuru .form-actions {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 10px;
}
#formUjianGuru .form-actions .btn {
    min-width: 0;
}
@media (max-width: 480px) {
    #formUjianGuru .form-actions {
        gap: 8px;
    }
    #formUjianGuru .form-actions .btn {
        min-width: 90px;
        padding: 10px 18px;
        font-size: 14px;
        height: 38px;
    }
}
</style>
</style>
<style>
/* Center horizontal konten utama di desktop */
@media (min-width: 768px) {
    .lock-card,
    .tab-content,
    .exam-links-list {
        margin-left: auto !important;
        margin-right: auto !important;
        left: 50%;
        transform: translateX(-50%);
        position: relative;
    }
}
</style>

<!-- Modal Akses Daftar Ujian (rapi, hanya HTML, script di bawah) -->
<div id="modalAksesUjian" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; overflow:auto; background-color:rgba(0,0,0,0.4);">
    <div class="modal-content-center">
    <h3 style="margin-top:0;">Akses Daftar Ujian</h3>
        <form id="formAksesUjian" onsubmit="return false;" autocomplete="off">
            <label for="npsnUjian">NPSN</label>
            <input type="text" id="npsnUjian" name="npsnUjian" maxlength="8" required autocomplete="off" autocapitalize="off" inputmode="numeric" style="width:100%;min-width:120px;max-width:100%;margin-bottom:10px;padding:10px 12px;font-size:15px;border:1.5px solid #cbd5e1;border-radius:8px;">
        <label for="pinUjian">PIN ujian</label>
        <input type="password" id="pinUjian" name="pinUjian" maxlength="8" required placeholder="PIN ujian" autocomplete="new-password" inputmode="numeric" style="width:100%;min-width:120px;max-width:100%;margin-bottom:10px;padding:10px 12px;font-size:15px;border:1.5px solid #cbd5e1;border-radius:8px;">
      <div id="modalNpsnPinValidationMsg" style="margin-bottom:10px; color:#ef4444; font-weight:600; font-size:13px; display:none;"></div>
            <div class="modal-btn-row">
                <button type="button" onclick="tutupModalUjian()">Batal</button>
                <button type="button" onclick="validateNpsnPinModal()">Validasi</button>
            </div>
    </form>
    <div id="daftarUjianContainer" style="margin-top:20px; display:none;"></div>
  </div>
</div>

<style>
.highlight-row { background: #fff8d6 !important; transition: background 0.28s ease; }
@keyframes spin { 0%{ transform: rotate(0deg);} 100%{ transform: rotate(360deg);} }

/* Override: pastikan teks pada tabel/label tidak diputar dan tetap horizontal */
table, thead, tbody, tr, th, td {
    writing-mode: horizontal-tb !important;
    transform: none !important;
    white-space: normal !important;
    text-orientation: mixed !important;
}

/* Khusus untuk tabel responsif yang menggunakan td:before */
#daftarSemuaMapelContainer td:before,
#daftarUjianGuruContainer td:before,
#daftarUjianGuruContainer th,
#daftarSemuaMapelContainer th {
    writing-mode: horizontal-tb !important;
    transform: none !important;
    display: block !important;
}

/* Penyesuaian kecil untuk layar sangat kecil agar tetap rapi */
@media (max-width: 480px) {
    #daftarSemuaMapelContainer table,
    #daftarUjianGuruContainer table {
        font-size: 14px;
    }
    #daftarSemuaMapelContainer td,
    #daftarUjianGuruContainer td {
        padding: 10px 8px !important;
    }
}
</style>

<style>
/* Tombol Batal & Validasi horizontal, rata tengah */
.modal-btn-row {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
    flex-wrap: wrap;
    overflow: initial;
}
.modal-btn-row button {
    min-width: 110px;
    padding: 12px 38px;
    white-space: nowrap;
    writing-mode: horizontal-tb;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    border-radius: 7px;
    border: 1.5px solid #cbd5e1;
    background: #f1f5f9;
    font-size: 15px;
    cursor: pointer;
    transition: background 0.2s;
}
.modal-btn-row button:last-child {
    background: var(--primary, #0052CC);
    color: #fff;
    border-color: var(--primary, #0052CC);
}
.modal-btn-row button:hover {
    filter: brightness(0.97);
}

/* Modal akses ujian center horizontal di desktop */
.modal-content-center {
    background: #fff;
    margin: 10% auto;
    padding: 20px;
    border-radius: 8px;
    width: 90%;
    max-width: 400px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    position: relative;
}
@media (min-width: 768px) {
    .modal-content-center {
        left: 50%;
        transform: translateX(-50%);
        margin-left: 0;
        margin-right: 0;
    }
}
</style>


<script>
// Validasi NPSN dan PIN dari modal
function validateNpsnPinModal() {
    var npsn = document.getElementById('npsnUjian').value.trim();
    var pin = document.getElementById('pinUjian').value.trim();
    var msg = document.getElementById('modalNpsnPinValidationMsg');
    var btn = document.querySelector('#modalAksesUjian button[onclick="validateNpsnPinModal()"]');
    
    if (!npsn || !pin) {
        msg.textContent = 'NPSN dan PIN harus diisi!';
        msg.style.display = 'block';
        return;
    }
    
    var daftarUjianContainer = document.getElementById('daftarUjianContainer');
    msg.style.display = 'none';
    
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner" style="display:inline-block;width:18px;height:18px;border:2px solid #ccc;border-top:2px solid #6366f1;border-radius:50%;animation:spin 0.8s linear infinite;margin-right:6px;"></span>Loading...';
    }
    
    // Helper untuk normalisasi (hapus non-digit jika perlu, atau cukup trim)
    const normalize = (val) => (val || '').toString().trim();
    const normalizeNumeric = (val) => (val || '').toString().replace(/\D/g, '');

    getExamLinks().then(function(links) {
        console.log('--- DEBUG VALIDATION (MODAL) ---');
        console.log('Input NPSN:', npsn);
        console.log('Input PIN:', pin);
        console.log('Total Links:', links.length);

        const filtered = links.filter(exam => {
            const examNpsn = normalize(exam.npsn);
            const examPin = normalize(exam.pin);
            const isActive = (exam.status === 'Aktif' || !exam.status);
            
            // Primary match (exact normalized)
            const isMatch = examNpsn === npsn && examPin === pin;
            
            // Secondary match (numeric only fallback)
            const isNumericMatch = normalizeNumeric(examNpsn) === normalizeNumeric(npsn) && 
                                  normalizeNumeric(examPin) === normalizeNumeric(pin) &&
                                  (npsn.length > 0 && pin.length > 0);

            if (isActive && (isMatch || isNumericMatch)) {
                console.log('✅ Match found:', exam.subject, '| NPSN:', examNpsn, '| PIN:', examPin);
                return true;
            }
            return false;
        });

        if (filtered.length > 0) {
            msg.style.display = 'none';
            let html = '<b>Daftar Ujian:</b><ul style="margin-top:8px;">';
            filtered.forEach(exam => {
                html += '<li>' + (exam.subject || 'Ujian') + ' - <a href="' + exam.url + '" target="_blank">Buka</a></li>';
            });
            html += '</ul>';
            daftarUjianContainer.innerHTML = html;
            daftarUjianContainer.style.display = 'block';
        } else {
            // Debugging info for user/admin
            const activeLinks = links.filter(exam => (exam.status === 'Aktif' || !exam.status));
            const availablePairs = activeLinks.map(e => `${normalize(e.npsn)}/${normalize(e.pin)}`).slice(0, 5);
            
            console.log('❌ No match. Active pairs (sample):', availablePairs);
            
            msg.textContent = 'NPSN/PIN tidak ditemukan atau status ujian nonaktif. ' + 
                             (availablePairs.length > 0 ? '\nPastikan format input benar.' : '\nTidak ada data ujian aktif.');
            msg.style.display = 'block';
            daftarUjianContainer.innerHTML = '';
            daftarUjianContainer.style.display = 'none';
        }
    }).catch(err => {
        console.error('Validation Error:', err);
        msg.textContent = 'Terjadi kesalahan sistem. Silakan coba lagi.';
        msg.style.display = 'block';
    }).finally(function() {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = 'Validasi';
        }
    });
}

// Fungsi untuk membuka modal akses ujian
function bukaModalUjian() {
    document.getElementById('modalAksesUjian').style.display = 'block';
    document.getElementById('daftarUjianContainer').style.display = 'none';
    document.getElementById('formAksesUjian').reset();
}
// Fungsi untuk menutup modal akses ujian
function tutupModalUjian() {
    document.getElementById('modalAksesUjian').style.display = 'none';
}
// Tutup modal jika klik di luar konten (akses ujian/admin/konfirmasi)
window.addEventListener('click', function(event) {
    var modalUjian = document.getElementById('modalAksesUjian');
    var modalKonfirmasi = document.getElementById('modalKonfirmasi');
    var modalAdmin = document.getElementById('modalAdminNpsn');
    // Jangan tutup jika klik tombol Admin
    if (event.target === document.getElementById('adminDropdownBtn')) return;
    if (event.target == modalUjian) {
        tutupModalUjian();
    }
    if (event.target == modalKonfirmasi) {
        tutupModal();
    }
    if (modalAdmin && event.target == modalAdmin) {
        tutupAdminNpsnModal();
    }
});
// Tangani submit form akses ujian
document.getElementById('formAksesUjian').onsubmit = function(e) {
    e.preventDefault();
    validateNpsnPinModal();
};
// Clear NPSN/PIN fields on load/pageshow to force retyping after refresh
(function(){
    function clearNpsnPinFields(){
        var ids = ['npsnUjian','pinUjian','filterNpsnAdmin','filterPinAdmin','editValidasiNpsn','editValidasiPin','editНpsnGuru','editPinGuru'];
        ids.forEach(function(id){
            try {
                var el = document.getElementById(id);
                if (el) {
                    el.value = '';
                    el.removeAttribute('value');
                    setTimeout(function(){ try{ el.value=''; el.removeAttribute('value'); }catch(e){} }, 50);
                }
            } catch(e){}
        });
    }
    window.addEventListener('pageshow', function(e){ setTimeout(clearNpsnPinFields, 50); });
    window.addEventListener('DOMContentLoaded', function(){ setTimeout(clearNpsnPinFields, 50); });
    window.addEventListener('beforeunload', function(){ clearNpsnPinFields(); });
})();

</script>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover, shrink-to-fit=no">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#0052CC">
    <meta name="format-detection" content="telephone=no">
    <title>EXAMUNA - Platform Ujian Aman</title>
    
    <!-- Preconnect untuk resource eksternal -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://unpkg.com">
    <link rel="dns-prefetch" href="https://script.google.com">
    <link rel="dns-prefetch" href="https://api.ipify.org">
    
    <!-- Font loading dengan async untuk performa lebih baik -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet" async>
    <noscript><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet"></noscript>
    
    <!-- QR Code library akan di-load secara dinamis saat dibutuhkan (lazy-load) -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-variant-numeric: tabular-nums;
            line-height: 1.5;
            touch-action: manipulation;
        }

        html {
            overflow: auto;
            overflow-x: hidden !important;
            width: 100%;
            max-width: 100%;
            scrollbar-gutter: stable;
        }

        :root {
            --primary: #0052CC;
            --primary-dark: #003D99;
            --secondary: #0066FF;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --bg-light: #f8fafc;
            --bg-medium: #f1f5f9;
            --bg-dark: #e2e8f0;
            --text-primary: #000000;
            --text-secondary: #000000;
            --border: #cbd5e1;
        }

        body {
            font-family: 'Outfit', Arial, sans-serif;
            background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
            color: var(--text-primary);
            min-height: 100vh;
            overflow: auto;
            overflow-x: hidden;
            user-select: none;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            -webkit-touch-callout: none;
            -webkit-tap-highlight-color: transparent;
            /* Android optimization */
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            font-variant-numeric: tabular-nums;
            line-height: 1.5;
            -webkit-text-stroke: 0.01px rgba(0,0,0,0.02);
            touch-action: manipulation;
            /* Responsive Design */
            width: 100%;
            max-width: 100%;
            height: auto;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            align-items: center;
            word-wrap: break-word;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        /* Android Safe Area Support */
        @supports (padding: max(0px)) {
            body {
                padding-left: max(0px, env(safe-area-inset-left));
                padding-right: max(0px, env(safe-area-inset-right));
                padding-bottom: max(0px, env(safe-area-inset-bottom));
            }
        }

        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 82, 204, 0.03);
            pointer-events: none;
            z-index: 0;
            will-change: auto;
        }

        /* Lock Screen - Linktree Style */
        .lock-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.04));
            backdrop-filter: blur(10px) saturate(120%);
            -webkit-backdrop-filter: blur(10px) saturate(120%);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 18px;
            padding: clamp(16px, 5vh, 28px) clamp(18px, 6vw, 36px);
            width: 100%;
            max-width: 420px;
            box-shadow: 0 12px 40px rgba(12, 30, 60, 0.18);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            margin: 12px auto;
            box-sizing: border-box;
        }

        /* Samakan lebar subtitle dan semua form/input/tombol di lock-card */
        .lock-card .lock-subtitle,
        .lock-card .form-group,
        .lock-card .form-group > *,
        .lock-card .btn,
        .lock-card .login-input {
            max-width: 420px;
            width: 100%;
            margin-left: auto;
            margin-right: auto;
            box-sizing: border-box;
        }
        .lock-card .form-group {
            align-items: stretch;
        }
        .lock-card .btn {
            min-width: 0;
        }
        
        .lock-screen::-webkit-scrollbar {
            width: 0;
            background: transparent;
        }
        
        .lock-screen::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .lock-screen::-webkit-scrollbar-thumb {
            background: transparent;
            border-radius: 3px;
        }
        
        .lock-screen::-webkit-scrollbar-thumb:hover {
            background: transparent;
        }
        
        .lock-screen::-webkit-scrollbar-thumb {
            background: transparent;
            border-radius: 4px;
        }
        
        .lock-screen::-webkit-scrollbar-thumb:hover {
            background: transparent;
        }

        .lock-screen.hidden {
            display: none;
        }

        .lock-card {
            background: transparent;
            backdrop-filter: none;
            border: none;
            border-radius: 0;
            padding: clamp(12px, 4vh, 24px) clamp(16px, 5vw, 32px);
            width: 100%;
            max-width: 600px;
            box-shadow: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0;
            margin: 0 auto;
            box-sizing: border-box;
            overflow: hidden;
        }

        .logo {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: clamp(0px, 0.4vw, 3px);
            margin-top: clamp(20px, 4vh, 45px);
            margin-bottom: clamp(8px, 2vh, 14px);
            cursor: pointer;
        }

        .logo-icon {
            width: clamp(48px, 12vw, 64px);
            height: clamp(48px, 12vw, 64px);
            background: linear-gradient(135deg, #B8860B, #FFD700);
            border-radius: 50%;
            border: 3px solid white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: clamp(24px, 6vw, 32px);
            font-weight: bold;
            color: white;
            box-shadow: 0 12px 40px rgba(212, 175, 55, 0.25);
            margin: 0 auto;
            flex-shrink: 0;
        }

        .logo-text {
            font-size: clamp(24px, 6vw, 28px);
            font-weight: 700;
            color: #D4AF37;
            margin-top: 0;
            text-align: center;
        }

        .logo-divider {
            width: clamp(60px, 30vw, 140px);
            height: 3px;
            background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.9), transparent);
            border-radius: 2px;
            margin-top: clamp(8px, 2vh, 12px);
            margin-bottom: 0;
        }

        .lock-title {
            text-align: center;
            font-size: clamp(28px, 8vw, 34px);
            font-weight: 700;
            margin: 0 auto 0 auto;
            color: #FFFFFF;
            width: 100%;
            max-width: 100%;
            display: block;
            word-wrap: break-word;
            word-break: break-word;
            box-sizing: border-box;
            padding: 0 8px;
            line-height: 1.3;
            text-shadow: 0 4px 12px rgba(0, 0, 0, 0.4), 0 0 20px rgba(255, 255, 255, 0.3);
        }
